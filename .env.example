# .env.example
ENVIRONMENT=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
MINIO_CONSOLE_PORT=9001

# User must provide: Host docker group ID for socket access (getent group docker)
DOCKER_GID=999

# User must provide: MinIO root (bootstrap only after Phase 8)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123

MINIO_BUCKET=minecraft-backups
# Generated by init script or provided
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=

MC_VERSION=1.20.4
MC_MEMORY=2G
MC_MAX_PLAYERS=20
MC_CONTAINER_NAME=cloud-minecraft
MC_PUBLIC_ADDRESS=localhost:25565
MINECRAFT_ONLINE_MODE=true
ENFORCE_SECURE_PROFILE=false


# User must provide (or generated): RCON password
RCON_PASSWORD=

# User must provide (or generated): Plugin-to-backend shared secret (32+ random bytes)
PLUGIN_API_KEY=

# User must provide (or generated): Key for hashing verification codes
CODE_HMAC_SECRET=

# User must provide (live mode): Firebase project ID
FIREBASE_PROJECT_ID=demo-project

# User must provide (live mode): Path to the service account JSON inside the container
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/firebase-service-account.json

FIREBASE_AUTH_EMULATOR_HOST=
# User must provide: Email that becomes Administrator on first verified login
BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com

# User must provide (live mode): Public Firebase web config and API URL
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_API_BASE_URL=http://localhost:8000

DASHBOARD_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

METRICS_INTERVAL_SECONDS=30
METRICS_RETENTION_DAYS=7
BACKUP_SCHEDULE_CRON=0 3 * * *
BACKUP_RETENTION_COUNT=10
CPU_ALERT_THRESHOLD=80
MEM_ALERT_THRESHOLD=90
DISK_ALERT_THRESHOLD=85
VERIFICATION_CODE_TTL_SECONDS=300
